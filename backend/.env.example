# Copy to .env for host runs. Every value has a default in app/config.py.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=main
API_PORT=8000

# Provided to candidates by email. Never commit real values.
# docker compose passes this file to the api and worker containers. Inside a
# container, localhost is the container itself, so a MODEL_URL that points at
# something running on your machine must use http://host.docker.internal:<port>.
MODEL_URL=https://api.markup.ai/interview/prompts
MODEL_API_KEY=
